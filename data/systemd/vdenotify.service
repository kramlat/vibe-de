[Unit]
Description=VDE notification daemon
Documentation=https://github.com/kramlat/vibe-de
# Registry settings (do not disturb, default timeout) come from the user's fhived if it is running, else
# from the hive file directly; this service works either way.
After=fhived.socket

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=/usr/lib/vde/VDENotify
Restart=on-failure
RestartSec=1

NoNewPrivileges=yes
LockPersonality=yes
UMask=0077

[Install]
# Lets D-Bus activation find this service under the name every notification client looks for.
Alias=dbus-org.freedesktop.Notifications.service
