[Unit]
Description=SYSMAN: HKEY_LOCAL_MACHINE\System, a Windows-shaped state of the machine
Documentation=https://github.com/kramlat/vibe-de
Requires=sysman.socket
After=sysman.socket systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/lib/vde/sysman --socket-activation
Restart=on-failure
RestartSec=1

# It reads /etc, /proc, /sys and udev's database and talks on one socket; nothing is written anywhere.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
