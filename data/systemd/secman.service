[Unit]
Description=SECMAN: HKEY_LOCAL_MACHINE\Security from the system's security modules
Documentation=https://github.com/kramlat/vibe-de
Requires=secman.socket
After=secman.socket

[Service]
Type=simple
ExecStart=/usr/lib/vde/secman --socket-activation
Restart=on-failure
RestartSec=1

# It reads configuration and kernel status files (the AppArmor profile list is root-only) and talks on one
# socket; nothing is written anywhere.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
