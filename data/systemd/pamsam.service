[Unit]
Description=PAMSAM: HKEY_LOCAL_MACHINE\SAM from the system's user accounts
Documentation=https://github.com/kramlat/vibe-de
Requires=pamsam.socket
After=pamsam.socket

[Service]
Type=simple
ExecStart=/usr/lib/vde/pamsam --socket-activation
Restart=on-failure
RestartSec=1

# It reads the account files (the password facts live in /etc/shadow) and talks on one socket; nothing else.
# Root, but only able to read files it does not own, and nothing is written anywhere.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
