Windows Registry Editor Version 5.00

; The system hive that ships with VDE. Built at install time with:
;   mkhive create --type system --rules permissions.rules /etc/hive/System.fhive system.reg
; Sections for HKEY_CLASSES_ROOT are stored under Software\Classes.

[HKEY_LOCAL_MACHINE\Software\Vde]
"Version"="0.1"

[HKEY_LOCAL_MACHINE\Software\Vde\Desktop]
; the default wallpaper (also the login screen's): a user's own choice under HKCU overrides it
"Wallpaper"="/usr/share/backgrounds/vde/Vibe.png"
"WallpaperMode"="Fill"

[HKEY_LOCAL_MACHINE\Software\Vde\Appearance]
"Theme"="fluent"
"Variant"="System"

[HKEY_CLASSES_ROOT\CLSID\inode/directory]
@="Folder"
"DefaultIcon"="folder"

[HKEY_CLASSES_ROOT\CLSID\application/x-desktop]
@="Application shortcut"
"DefaultIcon"="application-x-executable"
