#!/bin/sh
# start-vde-x11: the VDE session for a login that starts an X server (the "Vibe Desktop Environment (X11)" entry).
#
# vwm is a Wayland compositor; here it runs as a full-screen window of the X server (wlroots' X11 backend), and the
# rest of the session is the same as start-vde's. Programs that talk X11 still work through vwm's own Xwayland.

if [ -z "$DISPLAY" ]; then
    echo "start-vde-x11: no X server (DISPLAY is not set); log in through an X11 session or use start-vde" >&2
    exit 1
fi

# the size of the X screen, as WxH
size=$(xdpyinfo 2>/dev/null | sed -n 's/^ *dimensions: *\([0-9]*x[0-9]*\) pixels.*/\1/p' | head -n 1)
[ -z "$size" ] && size=$(xrandr 2>/dev/null | sed -n 's/^Screen 0:.*current \([0-9]*\) x \([0-9]*\),.*/\1x\2/p' | head -n 1)

export WLR_BACKENDS=x11
[ -n "$size" ] && export VWM_X11_SIZE="$size"
# a nested compositor must not inherit a Wayland display of some other session
unset WAYLAND_DISPLAY

here=$(dirname "$0")
for start in "$here/start-vde" "$(command -v start-vde)"; do
    [ -x "$start" ] && exec "$start" "$@"
done
echo "start-vde-x11: start-vde is not installed" >&2
exit 1
