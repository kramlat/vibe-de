[Desktop Entry]
Type=Application
Name=Terminal
GenericName=Terminal Emulator
Comment=Command line with tabs, PowerShell and bash
Exec=vterminal
Icon=utilities-terminal
Terminal=false
Categories=System;TerminalEmulator;
Keywords=shell;prompt;command;powershell;bash;console;
StartupWMClass=vterminal
Actions=NewWindow;PowerShell;

[Desktop Action NewWindow]
Name=New Window
Exec=vterminal

[Desktop Action PowerShell]
Name=PowerShell
Exec=vterminal -p PowerShell
