[Unit]
Description=VDE display manager
Documentation=https://github.com/kramlat/vibe-de
# Takes over the first virtual terminal from the text login, once the system is ready for users to log in.
After=systemd-user-sessions.service systemd-logind.service plymouth-quit-wait.service getty@tty1.service
Conflicts=getty@tty1.service
Wants=systemd-logind.service
# fhived serves the registry the greeter's theme and settings come from; vdedm works without it too (it reads the hive file)
After=fhived-system.socket

[Service]
Type=simple
ExecStart=/usr/lib/vde/vdedm
Restart=always
RestartSec=2
# A login screen that is stuck must not take the console with it: systemd restarts us, which restarts the greeter.
KillMode=mixed
TimeoutStopSec=20
# The display manager owns the seat: it needs to be root to start sessions for other users.
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
UtmpMode=user

[Install]
Alias=display-manager.service
WantedBy=graphical.target
