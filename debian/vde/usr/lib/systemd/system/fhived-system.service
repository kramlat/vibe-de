[Unit]
Description=VDE registry daemon (system hive)
Documentation=https://github.com/kramlat/vibe-de
Requires=fhived-system.socket
After=fhived-system.socket
# The system hive is made by mkhive at install time. Without it there is nothing to serve, and clients fall
# back to reading the file themselves (if it ever appears).
ConditionPathExists=/etc/hive/System.fhive

[Service]
Type=notify
ExecStart=/usr/lib/vde/fhived --system --socket-activation
Restart=on-failure
RestartSec=1

# It reads and writes one directory and talks on one socket; nothing else.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/etc/hive
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
