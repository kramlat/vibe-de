[Unit]
Description=VDE registry daemon (user hive)
Documentation=https://github.com/kramlat/vibe-de
Requires=fhived.socket
After=fhived.socket

[Service]
Type=notify
ExecStart=/usr/lib/vde/fhived --user --socket-activation
Restart=on-failure
RestartSec=1

NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
UMask=0077
