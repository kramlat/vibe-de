#!/bin/sh
set -e

case "$1" in
configure)
    systemd-sysusers vdedm.conf >/dev/null 2>&1 || true
    systemd-tmpfiles --create vdedm.conf >/dev/null 2>&1 || true
    if [ ! -e /etc/hive/System.fhive ]; then
        install -d -m755 /etc/hive
        /usr/lib/vde/mkhive create --type system --rules /usr/share/vde/registry/permissions.rules \
            /etc/hive/System.fhive /usr/share/vde/registry/system.reg >/dev/null || \
            echo "vde: could not create /etc/hive/System.fhive; see /usr/share/doc/vde/install.md" >&2
    elif ! /usr/lib/vde/mkhive dump /etc/hive/System.fhive 2>/dev/null | grep -q 'Software.Vde.Desktop'; then
        # an upgrade from a release without the default wallpaper
        /usr/lib/vde/mkhive create --type system --merge --rules /usr/share/vde/registry/permissions.rules \
            /etc/hive/System.fhive /usr/share/vde/registry/desktop.reg >/dev/null 2>&1 || true
    fi
    /usr/lib/vde/RegSvrVDE --system /s /i /usr/lib/vde/vexplore.dll >/dev/null 2>&1 || \
        echo "vde: could not register the shell components; run: RegSvrVDE --system /i /usr/lib/vde/vexplore.dll" >&2
    if [ "$1" = configure ] && [ -z "$2" ]; then
        cat <<MSG

  VDE is installed. It does not change how you log in.
  Try it inside your current desktop:  vde-session
  As a login session: pick "Vibe Desktop Environment" in your login manager, or run start-vde on a text console.
  Its own login screen (vdedm): read /usr/share/doc/vde/dm.md first (keep a text console available).

MSG
    fi
    ;;
esac

# Automatically added by dh_installtmpfiles/13.24.2
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -x "$(command -v systemd-tmpfiles)" ]; then
		systemd-tmpfiles ${DPKG_ROOT:+--root="$DPKG_ROOT"} --create vdedm.conf || true
	fi
fi
# End automatically added section
# Automatically added by dh_installsystemduser/13.24.2
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -z "$DPKG_ROOT" ] ; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper --user unmask 'fhived.socket' >/dev/null || true

		# was-enabled defaults to true, so new installations run enable.
		if deb-systemd-helper --quiet --user was-enabled 'fhived.socket' ; then
			# Enables the unit on first installation, creates new
			# symlinks on upgrades if the unit file has changed.
			deb-systemd-helper --user enable 'fhived.socket' >/dev/null || true
		else
			# Update the statefile to add new symlinks (if any), which need to be
			# cleaned up on purge. Also remove old symlinks.
			deb-systemd-helper --user update-state 'fhived.socket' >/dev/null || true
		fi
	fi
fi
# End automatically added section
# Automatically added by dh_installsystemduser/13.24.2
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -z "$DPKG_ROOT" ] ; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper --user unmask 'vdenotify.service' >/dev/null || true

		# was-enabled defaults to true, so new installations run enable.
		if deb-systemd-helper --quiet --user was-enabled 'vdenotify.service' ; then
			# Enables the unit on first installation, creates new
			# symlinks on upgrades if the unit file has changed.
			deb-systemd-helper --user enable 'vdenotify.service' >/dev/null || true
		else
			# Update the statefile to add new symlinks (if any), which need to be
			# cleaned up on purge. Also remove old symlinks.
			deb-systemd-helper --user update-state 'vdenotify.service' >/dev/null || true
		fi
	fi
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.24.2
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if deb-systemd-helper debian-installed 'fhived-system.socket'; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper unmask 'fhived-system.socket' >/dev/null || true

		if deb-systemd-helper --quiet was-enabled 'fhived-system.socket'; then
			# Create new symlinks, if any.
			deb-systemd-helper enable 'fhived-system.socket' >/dev/null || true
		fi
	fi

	# Update the statefile to add new symlinks (if any), which need to be cleaned
	# up on purge. Also remove old symlinks.
	deb-systemd-helper update-state 'fhived-system.socket' >/dev/null || true
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.24.2
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if deb-systemd-helper debian-installed 'vdedm.service'; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper unmask 'vdedm.service' >/dev/null || true

		if deb-systemd-helper --quiet was-enabled 'vdedm.service'; then
			# Create new symlinks, if any.
			deb-systemd-helper enable 'vdedm.service' >/dev/null || true
		fi
	fi

	# Update the statefile to add new symlinks (if any), which need to be cleaned
	# up on purge. Also remove old symlinks.
	deb-systemd-helper update-state 'vdedm.service' >/dev/null || true
fi
# End automatically added section

exit 0
