			deb-systemd-helper --user enable 'fhived.socket' >/dev/null || true
		else
			# Update the statefile to add new symlinks (if any), which need to be
			# cleaned up on purge. Also remove old symlinks.
			deb-systemd-helper --user update-state 'fhived.socket' >/dev/null || true
