<Project Sdk="Microsoft.NET.Sdk">

  <!-- SYSMAN: HKLM\System, a Windows-shaped view of the machine generated from /etc, /proc, /sys, /dev and udev. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Vde.SysMan</RootNamespace>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vibe.Registry.Remote\Vibe.Registry.Remote.csproj" />
  </ItemGroup>

</Project>
