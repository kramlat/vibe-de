<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VDENotify</AssemblyName>
    <RootNamespace>VdeNotify</RootNamespace>
    <!-- Installed tools run on whatever .NET the system has, if it is newer than the one we build with. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vde.Shell.Notifications.DBus\Vde.Shell.Notifications.DBus.csproj" />
    <ProjectReference Include="..\Vibe.Registry.Remote\Vibe.Registry.Remote.csproj" />
  </ItemGroup>

</Project>
